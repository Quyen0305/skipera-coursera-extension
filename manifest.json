{
  "manifest_version": 3,
  "name": "Skipera Coursera",
  "version": "1.3.0",
  "description": "Bản extension độc lập của Skipera: quản lý tác vụ Coursera trong trình duyệt.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://www.coursera.org/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.perplexity.ai/*"
  ],
  "action": {
    "default_title": "Skipera Coursera",
    "default_popup": "runner.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
